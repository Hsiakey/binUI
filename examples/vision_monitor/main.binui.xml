    <card x="352" y="198" w="64" h="1" color="#3E8BFF" radius="0"/>
    <card x="352" y="262" w="64" h="1" color="#3E8BFF" radius="0"/>
    <card x="352" y="198" w="1" h="65" color="#3E8BFF" radius="0"/>
    <card x="415" y="198" w="1" h="65" color="#3E8BFF" radius="0"/>
    <label x="352" y="178" w="120" h="16" color="#3E8BFF" size="11">target 0.982</label>
    <card x="494" y="286" w="52" h="1" color="#2FBF9A" radius="0"/>
