    <label x="214" y="374" w="240" h="16" color="#94A3B8" size="11">识别画面 · 430 × 340</label>

    <!-- 信息侧栏：竖分隔线 + 表头下分隔线 + 在线状态胶囊 -->
    <card x="630" y="30" w="1" h="390" color="#E6EDF7" radius="0"/>
    <card x="634" y="58" w="240" h="1" color="#E6EDF7" radius="0"/>
