<binui width="900" height="680" bg="#F4F7FC">
    <!-- 浅色控制台主题：
         页面底 #F4F7FC（工作区与日志区之间的缝）/ 卡片面 #FFFFFF / 次级面 #EEF3FA
         分隔线 #E6EDF7 · #DCE5F2 / 主字 #1F2A37 / 次字 #66768C / 弱字 #94A3B8
         主色 #3E8BFF · 薄荷 #2FBF9A · 琥珀 #F2B544 · 天蓝 #38BDF8 · 危险红 #FF6B6B
         圆角：画面面板 12 / 识别面板 14 / 按钮 9~10 / 胶囊 9 -->
    <!-- 说明：XML 侧只认 color / bg / size / radius，
         文字色写在 <label> 的 color 上，<button> 的 color 是底色（字固定白色加粗） -->
    <!-- 左面板背景（工作区白面） -->
    <card x="0" y="30" w="180" h="390" color="#FFFFFF" radius="0"/>
    <!-- 中面板背景 -->
    <card x="180" y="30" w="450" h="390" color="#FFFFFF" radius="0"/>
    <!-- 右面板背景 -->
    <card x="630" y="30" w="270" h="390" color="#FFFFFF" radius="0"/>
    <!-- 自绘标题栏（可拖动窗口；─ 最小化，□ 最大化，✕ 关闭） -->
    <titlebar x="0" y="0" w="900" h="30" color="#FFFFFF">
        <label x="26" y="5" w="300" h="20" color="#1F2A37" size="14">视觉监视器</label>
        <button x="840" y="6" w="18" h="18" color="#94A3B8" radius="9" size="12">─</button>
        <button x="860" y="6" w="18" h="18" color="#94A3B8" radius="9" size="12">□</button>
        <button x="880" y="6" w="18" h="18" color="#FF6B6B" radius="9" size="12">✕</button>
    </titlebar>
    <!-- 左侧内容 -->
    <label x="6" y="36" w="80" h="18" color="#66768C" size="12">原画</label>
    <card x="10" y="56" w="160" h="90" color="#DCE5F2" radius="12"/>
    <label x="6" y="158" w="80" h="18" color="#66768C" size="12">目标</label>
    <card x="10" y="176" w="160" h="90" color="#DCE5F2" radius="12"/>
    <!-- 识别面板 -->
    <label x="186" y="36" w="80" h="18" color="#66768C" size="12">识别</label>
    <card x="190" y="60" w="430" h="340" color="#DCE5F2" radius="14"/>
    <!-- 信息面板 -->
    <label x="634" y="36" w="80" h="18" color="#66768C" size="12">信息</label>
    <label x="634" y="68" w="240" h="140" color="#66768C" size="12">等待连接...</label>
    <!-- 日志面板：整条次级面 #EEF3FA，与上方白色工作区之间留页面底色缝 -->
    <card x="0" y="428" w="900" h="252" color="#EEF3FA" radius="0"/>
    <label x="22" y="438" w="80" h="18" color="#66768C" size="12">日志</label>
    <label x="22" y="462" w="856" h="18" color="#66768C" size="11">[系统] 视觉监视器已启动</label>
    <label x="22" y="480" w="856" h="18" color="#66768C" size="11">[系统] 等待 WebSocket 连接...</label>

    <!-- ===== 浅色主题装饰层（绘制在最上层） ===== -->
    <!-- 标题栏底部 1px 分隔线 + 品牌色圆点 + 副文案 -->
    <card x="0" y="29" w="900" h="1" color="#E6EDF7" radius="0"/>
    <card x="10" y="11" w="8" h="8" color="#3E8BFF" radius="4"/>
    <label x="112" y="8" w="260" h="16" color="#94A3B8" size="11">实时识别 · WebSocket 在线</label>

    <!-- 原画占位：1px 边框（外层）+ 淡灰蓝画面（内层）+ 状态点 -->
    <card x="11" y="57" w="158" h="88" color="#EEF3FA" radius="11"/>
    <card x="149" y="64" w="7" h="7" color="#2FBF9A" radius="3"/>
    <label x="34" y="95" w="130" h="16" color="#66768C" size="11">1024 × 768 · 30fps</label>
    <!-- 目标占位 -->
    <card x="11" y="177" w="158" h="88" color="#EEF3FA" radius="11"/>
    <card x="149" y="184" w="7" h="7" color="#F2B544" radius="3"/>
    <label x="44" y="215" w="120" h="16" color="#66768C" size="11">模板 64 × 64</label>

    <!-- 左栏底部：采集参数小字块 -->
    <card x="10" y="286" w="160" h="1" color="#E6EDF7" radius="0"/>
