# 统一换行：仓库内一律 LF，检出时按平台自动转换
* text=auto eol=lf

# Windows 脚本/工程文件用 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 源码
*.c    text
*.cc   text
*.cpp  text
*.h    text
*.hpp  text
*.html text
*.xml  text
*.md   text
*.yml  text
*.yaml text
*.sh   text eol=lf
Makefile text

# 二进制资源（不做 diff/合并）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.binui binary
*.bui  binary
*.bum  binary

# 生成的二进制布局文件不参与 GitHub 语言统计
*.binui linguist-generated
*.bui   linguist-generated
*.bum   linguist-generated
