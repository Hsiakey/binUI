<!--
  dialogue.bum.xml —— 对话气泡卡：角色名胶囊 + 正文 + 右下操作按钮
  参数：name 角色名 / text 正文 / ok / cancel 按钮文案 / w 宽 / h 高
  正文是单个 LABEL，会按卡片宽度自动换行；换行后的行高由 line-height 控制。
-->
<style>
    .bui-dlg        { background:#FFFFFF; border:1px solid #E6EDF7; }
    .bui-dlg-name   { background:#E8F1FF; color:#2F79E8; border-radius:12; font-size:13px;
                      font-weight:700; }
    .bui-dlg-text   { color:#1F2A37; font-size:14px; line-height:170%; }
</style>
<div class="bui-dlg" style="width:{{w=560}}; height:{{h=180}}; border-radius:16; padding:16">
    <span class="bui-dlg-name" style="position:absolute; left:16; top:14; width:{{namew=84}}; height:24">{{name=角色}}</span>
    <span class="bui-dlg-text" style="position:absolute; left:16; top:48; width:{{tw=520}}; height:{{th=88}}">{{text=正文}}</span>
    <button class="bui-btn primary" style="position:absolute; left:{{okx=300}}; top:{{btny=144}}; width:{{bw=80}}; height:32; border-radius:10; font-size:13px">{{ok=确定}}</button>
    <button class="bui-btn secondary" style="position:absolute; left:{{cx=392}}; top:{{btny=144}}; width:{{bw=80}}; height:32; border-radius:10; font-size:13px">{{cancel=取消}}</button>
</div>
